rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administração: identificada pelo código da conta (UID) do e-mail institucional.
    function isAdmin() {
      return request.auth != null && request.auth.uid == '44DVOSWvHbWBCVpIAKJvbMoUHHx1';
    }
    // Advogado com acesso criado pela Administração e não bloqueado.
    function isMember() {
      return request.auth != null
        && get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.ativo == true;
    }
    // Lista de acessos: só a Administração altera; cada advogado lê o próprio registro.
    match /acessos/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    // Histórico de atividade: pode ser lido e acrescentado, nunca editado ou apagado.
    match /log/{id} {
      allow read, create: if isAdmin() || isMember();
      allow update, delete: if false;
    }
    // Dados do escritório: advogados ativos leem, criam e editam; só a Administração exclui.
    match /{col}/{id} {
      allow read, create, update: if col != 'acessos' && col != 'log' && (isAdmin() || isMember());
      allow delete: if col != 'acessos' && col != 'log' && isAdmin();
    }
  }
}
