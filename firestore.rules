rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só o e-mail institucional do escritório pode ler e gravar.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'pinheiroadvogados.rn@gmail.com';
    }
  }
}
