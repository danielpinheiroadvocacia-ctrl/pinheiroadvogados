rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administração: e-mail institucional. Cria, bloqueia e reativa acessos.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'pinheiroadvogados.rn@gmail.com';
    }
    // Advogado com acesso criado pela Administração e não bloqueado.
    function isMember() {
      return request.auth != null
        && get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.ativo == true;
    }
    // Lista de acessos: só a Administração altera; cada advogado lê o próprio registro.
    match /acessos/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    // Dados do escritório: Administração e advogados ativos.
    match /{col}/{id} {
      allow read, write: if col != 'acessos' && (isAdmin() || isMember());
    }
  }
}
